# Normalizza i fine riga: nel repository sono sempre salvati come LF, e git li
# converte in CRLF solo al checkout se serve alla piattaforma che li usa.
# Risolve il rumore visto su .gitignore, i file .idea/* e Bootstrap (file
# "modificati" riga per riga per un cambio di fine riga, non di contenuto).
* text=auto eol=lf

# I file di progetto Visual Studio (.sln) restano CRLF: alcuni tool Microsoft
# sono permalosi se non lo sono.
*.sln text eol=crlf

# Sorgenti .NET / configurazione
*.cs text eol=lf
*.razor text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.user text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.proto text eol=lf
*.http text eol=lf
*.ps1 text eol=lf
*.env text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf

# Immagini: binarie, nessuna conversione/diff testuale.
*.png binary
*.ico binary

# Bootstrap vendorizzato (mai editato a mano): escluso dalle statistiche
# linguaggio e dai diff "a schermo" di GitHub, oltre che dalla normalizzazione
# dei fine riga qui sopra.
src/TechInterview.Web/wwwroot/lib/** linguist-vendored linguist-generated -diff
