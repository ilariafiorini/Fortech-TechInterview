# Porte esposte sull'host per l'ambiente Docker Compose. Modifica pure questi valori se
# qualcuno di questi numeri e' gia' occupato da altri servizi sul tuo computer: Docker
# Compose legge automaticamente questo file (deve chiamarsi ".env" e stare in questa
# cartella) senza bisogno di toccare docker-compose.yml.
#
# Dopo una modifica, riavvia con: docker compose down && docker compose up --build

WEBFRONTEND_PORT=8080
AIRPORTS_PORT=8081
FLIGHTS_PORT=8082
GLOBALSEARCH_PORT=8083
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_DASHBOARD_OTLP_PORT=18889
REDIS_PORT=6379
REDIS_COMMANDER_PORT=8084
