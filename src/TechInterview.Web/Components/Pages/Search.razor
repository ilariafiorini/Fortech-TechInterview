@page "/search"
@rendermode InteractiveServer
@using TechInterview.Web.Components.Shared
@inject NavigationManager Nav

<h3>Search</h3>

<div class="mb-3">
    <label for="searchKey" class="form-label">Chiave di ricerca (almeno 3 caratteri)</label>
    <input id="searchKey"
           class="form-control"
           @bind="_query"
           @bind:event="oninput"
           @onkeydown="OnKeyDown" />
</div>

<button class="btn btn-primary" @onclick="OnSearchClicked" disabled="@(_query.Trim().Length < 3)">
    Cerca
</button>

@code {
    // PROTOTIPO DI STUDIO (branch prototype/real-search): pagina ridotta al solo modulo di
    // ricerca. I risultati vivono in tre pagine separate (SearchAll/SearchAirports/
    // SearchFlights.razor), raggiungibili dai sottopulsanti della sidebar — vedi
    // SearchNavigation.cs per lo schema URL condiviso e docs/architecture.md per tutte le
    // decisioni prese sul comportamento.

    private string _query = string.Empty;
    private int _limit = 20;

    protected override void OnInitialized()
    {
        // Se si torna qui da una ricerca gia' in corso (es. dalla sidebar mentre si sta
        // guardando Flights), il campo si ripresenta gia' valorizzato con l'ultima query:
        // l'ultima ricerca e' sempre il punto di partenza della successiva.
        var state = SearchNavigation.ReadFrom(Nav);
        _query = state.Query;
        _limit = state.Limit;
    }

    private Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Enter" && _query.Trim().Length >= 3 ? OnSearchClicked() : Task.CompletedTask;

    private Task OnSearchClicked()
    {
        // Nuova ricerca: azzera tutti e tre gli offset (vedi SearchNavigation.cs) e apre la
        // vista "All" — le altre due schede restano un click di distanza.
        var newState = new SearchNavigation.State(_query.Trim(), _limit, AllOffset: 0, AirportsOffset: 0, FlightsOffset: 0);
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.AllPath, newState));
        return Task.CompletedTask;
    }
}
