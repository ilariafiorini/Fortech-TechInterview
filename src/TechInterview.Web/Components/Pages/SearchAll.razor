@page "/search/all"
@rendermode InteractiveServer
@using TechInterview.Web.Components.Shared
@inject NavigationManager Nav
@inject IHttpClientFactory ClientFactory

<h3>Search — All</h3>

@if (!_state.HasQuery)
{
    <p>Nessuna ricerca in corso. <NavLink href="@SearchNavigation.SearchPath">Torna alla pagina di ricerca</NavLink>.</p>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <SearchResultsTable
        Items="_results"
        Offset="_state.AllOffset"
        Limit="_state.Limit"
        TotalCount="_totalCount"
        IsLoading="_isLoading"
        HasSearched="true"
        ShowResourceTypeColumn="true"
        ReturnUrl="@SearchNavigation.BuildUrl(SearchNavigation.AllPath, _state)"
        Query="@_state.Query"
        OnPreviousClicked="PreviousPage"
        OnNextClicked="NextPage" />
}

@code {
    // PROTOTIPO DI STUDIO (branch prototype/real-search): vista "Globale" delle tre pagine
    // di risultati (le altre due sono SearchAirports.razor/SearchFlights.razor). Stesso
    // schema URL condiviso (SearchNavigation.cs): l'offset che questa pagina possiede e
    // aggiorna e' solo AllOffset, gli altri due viaggiano intatti attraverso di essa.

    private SearchNavigation.State _state = new(string.Empty, 20, 0, 0, 0);
    private List<SearchResultDto>? _results;
    private int _totalCount;
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _state = SearchNavigation.ReadFrom(Nav);

        if (_state.HasQuery)
        {
            await LoadResults();
        }
    }

    private async Task LoadResults()
    {
        _error = null;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("globalsearch");
            var url = $"/api/global-search?query={Uri.EscapeDataString(_state.Query.Trim())}&offset={_state.AllOffset}&limit={_state.Limit}";
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<SearchResponseDto>();
                _results = body?.Items ?? new List<SearchResultDto>();
                _totalCount = body?.Count ?? 0;
            }
            else
            {
                var problem = await response.Content.ReadAsStringAsync();
                _error = $"Errore {(int)response.StatusCode}: {problem}";
                _results = new List<SearchResultDto>();
                _totalCount = 0;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task NextPage()
    {
        _state = _state with { AllOffset = _state.AllOffset + _state.Limit };
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.AllPath, _state), replace: true);
        await LoadResults();
    }

    private async Task PreviousPage()
    {
        _state = _state with { AllOffset = Math.Max(0, _state.AllOffset - _state.Limit) };
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.AllPath, _state), replace: true);
        await LoadResults();
    }
}
