@page "/search/flights"
@rendermode InteractiveServer
@using TechInterview.Web.Components.Shared
@inject NavigationManager Nav
@inject IHttpClientFactory ClientFactory

<h3>Search — Flights</h3>

@if (!_state.HasQuery)
{
    <p>Nessuna ricerca in corso. <NavLink href="@SearchNavigation.SearchPath">Torna alla pagina di ricerca</NavLink>.</p>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <SearchResultsTable
        Items="_results"
        Offset="_state.FlightsOffset"
        Limit="_state.FlightsLimit"
        TotalCount="_totalCount"
        IsLoading="_isLoading"
        HasSearched="true"
        ShowResourceTypeColumn="false"
        ReturnUrl="@SearchNavigation.BuildUrl(SearchNavigation.FlightsPath, _state)"
        Query="@_state.Query"
        OnPreviousClicked="PreviousPage"
        OnNextClicked="NextPage"
        OnLimitChanged="OnLimitChanged" />
}

@code {
    // PROTOTIPO DI STUDIO (branch prototype/real-search): vista "Flights" — usa
    // resourceType=flight (vedi GlobalSearchController.cs), quindi paginazione e count
    // reali sul solo sottoinsieme voli, non su quello globale. L'offset di questa pagina e'
    // FlightsOffset; gli altri due viaggiano intatti attraverso di essa (vedi
    // SearchNavigation.cs).

    private SearchNavigation.State _state = new(string.Empty, 20, 20, 20, 0, 0, 0);
    private List<SearchResultDto>? _results;
    private int _totalCount;
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _state = SearchNavigation.ReadFrom(Nav);

        if (_state.HasQuery)
        {
            await LoadResults();
        }
    }

    private async Task LoadResults()
    {
        _error = null;
        _isLoading = true;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("globalsearch");
            var url = $"/api/global-search?query={Uri.EscapeDataString(_state.Query.Trim())}&offset={_state.FlightsOffset}&limit={_state.FlightsLimit}&resourceType=flight";
            var response = await client.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<SearchResponseDto>();
                _results = body?.Items ?? new List<SearchResultDto>();
                _totalCount = body?.Count ?? 0;
            }
            else
            {
                var problem = await response.Content.ReadAsStringAsync();
                _error = $"Errore {(int)response.StatusCode}: {problem}";
                _results = new List<SearchResultDto>();
                _totalCount = 0;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task NextPage()
    {
        _state = _state with { FlightsOffset = _state.FlightsOffset + _state.FlightsLimit };
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.FlightsPath, _state), replace: true);
        await LoadResults();
    }

    private async Task PreviousPage()
    {
        _state = _state with { FlightsOffset = Math.Max(0, _state.FlightsOffset - _state.FlightsLimit) };
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.FlightsPath, _state), replace: true);
        await LoadResults();
    }

    private async Task OnLimitChanged(int newLimit)
    {
        // Un offset calcolato con il vecchio limite non corrisponde piu' a nulla di
        // sensato una volta cambiata la dimensione di pagina: si riparte dalla prima
        // pagina di questa scheda, lasciando invariati gli altri campi (incluso il limite
        // delle altre due schede, indipendente da questo — vedi SearchNavigation.cs).
        _state = _state with { FlightsLimit = newLimit, FlightsOffset = 0 };
        Nav.NavigateTo(SearchNavigation.BuildUrl(SearchNavigation.FlightsPath, _state), replace: true);
        await LoadResults();
    }
}
